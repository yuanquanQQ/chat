LISTEN_ADDRESS=:8080
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgres://chat:replace-with-a-strong-database-password@postgres:5432/chat?sslmode=disable
JWT_SECRET=replace-with-at-least-32-random-characters
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password
MAX_DEVICES=3
MINIO_ROOT_USER=chat-admin
MINIO_ROOT_PASSWORD=replace-with-a-strong-minio-password
